# Everything below the encryption key is optional server-wide defaults. Each company can instead connect its own
# AI model, web search, Stripe, Shopify and Google Analytics on the Connections page.

# ---- Required in production: encrypts connection secrets (API keys, tokens) stored in the database ----
# Any long random string, e.g. `openssl rand -base64 32`. Changing it makes saved secrets unreadable.
# Local development without DATABASE_URL generates one in .data/encryption.key.
BUDERA_ENCRYPTION_KEY=

# ---- AI model: any OpenAI-compatible chat completions API ----
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (LLM_API_KEY can be empty)
LLM_BASE_URL=
LLM_API_KEY=
# Model name as your provider spells it, e.g. gpt-4.1-mini or meta-llama/llama-3.3-70b-instruct
LLM_MODEL=
# Optional: a different (often cheaper, faster) model for the research tool loop
LLM_RESEARCH_MODEL=
# json_schema (default) or json_object for providers without strict structured outputs
LLM_STRUCTURED_OUTPUT=
# Optional JSON object of extra headers, e.g. {"HTTP-Referer":"https://budera.app","X-Title":"Budera"} for OpenRouter
LLM_EXTRA_HEADERS=

# ---- Web search for research agents: tavily, brave or serper ----
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---- Scheduled custom agents ----
# Any long random string. The scheduler calls /api/cron/scheduled with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---- Demo ----
# "Try the live demo" creates a throwaway sample workspace (deleted after 24 hours). Set to false to turn it off.
DEMO_ENABLED=
# Hosted deployments only allow companies to use public https model URLs. Set to true to allow private addresses
# (for example a self-hosted model on your network).
ALLOW_PRIVATE_MODEL_URLS=

# ---- Database ----
# Postgres connection string for production. Leave empty locally to use the embedded database in ./.data
DATABASE_URL=
